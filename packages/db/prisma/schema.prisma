generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Chat {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
  userId    Int
  roomId    Int
  Room      Room     @relation(fields: [roomId], references: [id])
  User      User     @relation(fields: [userId], references: [id])
}

model Room {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  createdAt DateTime @default(now())
  adminId   Int
  admin     User     @relation("AdminRooms", fields: [adminId], references: [id])
  Chat      Chat[]
  members   User[]   @relation("RoomMembers")


  drawings Drawing[]
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  photo     String?
  Chat      Chat[]
  rooms      Room[]   @relation("AdminRooms")
  memberRooms     Room[]   @relation("RoomMembers")

  drawings Drawing[]
}

model Drawing {
  id        Int     @id @default(autoincrement())
  elementId String  // the uid() from frontend
  type      String  // rectangle, line, pen
  x1        Float
  y1        Float
  x2        Float
  y2        Float
  points    String? // JSON string for pen strokes
  userId    Int
  roomId    Int
  user      User    @relation(fields: [userId], references: [id])
  room      Room    @relation(fields: [roomId], references: [id])
}
